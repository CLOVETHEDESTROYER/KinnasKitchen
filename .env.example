# Local previews stay out of search by default.
# Set these on the final production host after the domain and redirects are ready.
# SITE_URL=https://www.kinnaskitchen.com
# SITE_INDEXABLE=true
# Paste the exact owner-approved Square payment/store link here, then restart.
# Keep unset until the real URL has been supplied and reviewed.
# SQUARE_PAYMENT_LINK=
# ORDERING_URL remains supported as a legacy alias; SQUARE_PAYMENT_LINK takes precedence.
# Keep real values in ignored local environment files or the host's secret store.
# Never place payment-provider access tokens in browser-exposed variables.
