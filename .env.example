# Next.js loads .env.local for local development. Add real values privately.
# Do not prefix any credentials with NEXT_PUBLIC_ or VITE_.
SITE_URL=https://kinnaskitchen.vercel.app
SITE_INDEXABLE=false
SQUARE_ENVIRONMENT=sandbox
SQUARE_LIVE_ENABLED=false
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_MERCHANT_ID=
SQUARE_CATALOG_MAPPING={}
CHECKOUT_SIGNING_SECRET=
# Upstash Redis REST credentials, separate database per Sandbox/production.
# Vercel integration aliases KV_REST_API_URL and KV_REST_API_TOKEN are also supported.
# Local Sandbox alone may omit these; Vercel always requires them for checkout.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Register this exact URL in the matching Square application environment.
SQUARE_WEBHOOK_URL=https://kinnaskitchen.vercel.app/api/square/webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Set only when checkout origin differs from SITE_URL; otherwise omit.
# CHECKOUT_ORIGIN=https://kinnaskitchen.vercel.app
# Legacy alternative only; does not carry an integrated bag.
# SQUARE_PAYMENT_LINK=
# SQUARE_LAOS_CHILE_PASTE_LINK=
# SQUARE_VEGAN_CHILE_PASTE_LINK=
# SQUARE_MANGO_SALSA_LINK=
# SQUARE_TAMARIND_SAUCE_LINK=
